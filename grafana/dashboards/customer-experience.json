{
  "dashboard": {
    "title": "MarketSage - Customer Experience",
    "uid": "marketsage-customer-experience",
    "tags": ["customer", "experience", "frontend", "performance", "web-vitals"],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "5m",
    "time": {
      "from": "now-24h",
      "to": "now"
    },
    "panels": [
      {
        "type": "row",
        "title": "Core Web Vitals",
        "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
        "collapsed": false
      },
      {
        "id": 1,
        "type": "gauge",
        "title": "LCP - Largest Contentful Paint (Target: < 2.5s)",
        "gridPos": { "x": 0, "y": 1, "w": 6, "h": 6 },
        "targets": [
          {
            "expr": "histogram_quantile(0.75, sum(rate(web_vitals_lcp_bucket[1h])) by (le))",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "min": 0,
            "max": 4,
            "decimals": 2,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": 0, "color": "green" },
                { "value": 2.5, "color": "yellow" },
                { "value": 4, "color": "red" }
              ]
            }
          }
        },
        "options": {
          "showThresholdLabels": true,
          "showThresholdMarkers": true
        }
      },
      {
        "id": 2,
        "type": "gauge",
        "title": "FID - First Input Delay (Target: < 100ms)",
        "gridPos": { "x": 6, "y": 1, "w": 6, "h": 6 },
        "targets": [
          {
            "expr": "histogram_quantile(0.75, sum(rate(web_vitals_fid_bucket[1h])) by (le))",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ms",
            "min": 0,
            "max": 300,
            "decimals": 0,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": 0, "color": "green" },
                { "value": 100, "color": "yellow" },
                { "value": 300, "color": "red" }
              ]
            }
          }
        },
        "options": {
          "showThresholdLabels": true,
          "showThresholdMarkers": true
        }
      },
      {
        "id": 3,
        "type": "gauge",
        "title": "CLS - Cumulative Layout Shift (Target: < 0.1)",
        "gridPos": { "x": 12, "y": 1, "w": 6, "h": 6 },
        "targets": [
          {
            "expr": "histogram_quantile(0.75, sum(rate(web_vitals_cls_bucket[1h])) by (le))",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "min": 0,
            "max": 0.25,
            "decimals": 3,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": 0, "color": "green" },
                { "value": 0.1, "color": "yellow" },
                { "value": 0.25, "color": "red" }
              ]
            }
          }
        },
        "options": {
          "showThresholdLabels": true,
          "showThresholdMarkers": true
        }
      },
      {
        "id": 4,
        "type": "gauge",
        "title": "INP - Interaction to Next Paint (Target: < 200ms)",
        "gridPos": { "x": 18, "y": 1, "w": 6, "h": 6 },
        "targets": [
          {
            "expr": "histogram_quantile(0.75, sum(rate(web_vitals_inp_bucket[1h])) by (le))",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ms",
            "min": 0,
            "max": 500,
            "decimals": 0,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": 0, "color": "green" },
                { "value": 200, "color": "yellow" },
                { "value": 500, "color": "red" }
              ]
            }
          }
        },
        "options": {
          "showThresholdLabels": true,
          "showThresholdMarkers": true
        }
      },
      {
        "type": "row",
        "title": "Page Performance",
        "gridPos": { "x": 0, "y": 7, "w": 24, "h": 1 },
        "collapsed": false
      },
      {
        "id": 5,
        "type": "timeseries",
        "title": "Page Load Time Distribution",
        "gridPos": { "x": 0, "y": 8, "w": 12, "h": 6 },
        "targets": [
          {
            "expr": "histogram_quantile(0.50, sum(rate(page_load_duration_bucket[5m])) by (le))",
            "refId": "A",
            "legendFormat": "p50"
          },
          {
            "expr": "histogram_quantile(0.75, sum(rate(page_load_duration_bucket[5m])) by (le))",
            "refId": "B",
            "legendFormat": "p75"
          },
          {
            "expr": "histogram_quantile(0.95, sum(rate(page_load_duration_bucket[5m])) by (le))",
            "refId": "C",
            "legendFormat": "p95"
          },
          {
            "expr": "histogram_quantile(0.99, sum(rate(page_load_duration_bucket[5m])) by (le))",
            "refId": "D",
            "legendFormat": "p99"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ms",
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 10,
              "gradientMode": "none",
              "axisPlacement": "auto",
              "drawStyle": "line",
              "pointSize": 5,
              "showPoints": "never"
            }
          }
        },
        "options": {
          "tooltip": {
            "mode": "multi"
          },
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          }
        }
      },
      {
        "id": 6,
        "type": "table",
        "title": "Slowest Pages (p95 > 3s)",
        "gridPos": { "x": 12, "y": 8, "w": 12, "h": 6 },
        "targets": [
          {
            "expr": "topk(10, histogram_quantile(0.95, sum(rate(page_load_duration_bucket[1h])) by (le, page)) > 3000)",
            "refId": "A",
            "format": "table",
            "instant": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ms"
          },
          "overrides": []
        },
        "options": {
          "showHeader": true,
          "sortBy": [
            {
              "displayName": "Value",
              "desc": true
            }
          ]
        },
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {
                "Time": true,
                "le": true
              },
              "renameByName": {
                "page": "Page",
                "Value": "p95 Load Time (ms)"
              }
            }
          }
        ]
      },
      {
        "type": "row",
        "title": "Errors & Issues",
        "gridPos": { "x": 0, "y": 14, "w": 24, "h": 1 },
        "collapsed": false
      },
      {
        "id": 7,
        "type": "stat",
        "title": "Frontend Error Rate",
        "gridPos": { "x": 0, "y": 15, "w": 6, "h": 4 },
        "targets": [
          {
            "expr": "sum(rate(frontend_errors_total[1h])) / sum(rate(page_views_total[1h])) * 100",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "decimals": 2,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": 0, "color": "green" },
                { "value": 0.1, "color": "yellow" },
                { "value": 1, "color": "red" }
              ]
            }
          }
        },
        "options": {
          "colorMode": "background",
          "graphMode": "area",
          "orientation": "auto",
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"]
          }
        }
      },
      {
        "id": 8,
        "type": "stat",
        "title": "Error Boundary Triggers (24h)",
        "gridPos": { "x": 6, "y": 15, "w": 6, "h": 4 },
        "targets": [
          {
            "expr": "sum(increase(error_boundary_triggered_total[24h]))",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "decimals": 0,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": 0, "color": "green" },
                { "value": 10, "color": "yellow" },
                { "value": 50, "color": "red" }
              ]
            }
          }
        },
        "options": {
          "colorMode": "background",
          "graphMode": "area",
          "orientation": "auto",
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"]
          }
        }
      },
      {
        "id": 9,
        "type": "table",
        "title": "Most Common Errors (24h)",
        "gridPos": { "x": 12, "y": 15, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "topk(10, sum(increase(frontend_errors_total[24h])) by (error_type, error_message))",
            "refId": "A",
            "format": "table",
            "instant": true
          }
        ],
        "fieldConfig": {
          "defaults": {},
          "overrides": []
        },
        "options": {
          "showHeader": true,
          "sortBy": [
            {
              "displayName": "Value",
              "desc": true
            }
          ]
        },
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {
                "Time": true
              },
              "renameByName": {
                "error_type": "Error Type",
                "error_message": "Error Message",
                "Value": "Count"
              }
            }
          }
        ]
      },
      {
        "id": 10,
        "type": "timeseries",
        "title": "Error Rate by Page",
        "gridPos": { "x": 0, "y": 19, "w": 12, "h": 6 },
        "targets": [
          {
            "expr": "sum(rate(frontend_errors_total[5m])) by (page)",
            "refId": "A",
            "legendFormat": "{{page}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 10,
              "gradientMode": "none",
              "axisPlacement": "auto",
              "drawStyle": "line",
              "pointSize": 5,
              "showPoints": "never"
            }
          }
        },
        "options": {
          "tooltip": {
            "mode": "multi"
          },
          "legend": {
            "displayMode": "table",
            "placement": "right",
            "values": ["mean"]
          }
        }
      },
      {
        "type": "row",
        "title": "User Engagement",
        "gridPos": { "x": 0, "y": 25, "w": 24, "h": 1 },
        "collapsed": false
      },
      {
        "id": 11,
        "type": "timeseries",
        "title": "Page Views",
        "gridPos": { "x": 0, "y": 26, "w": 12, "h": 6 },
        "targets": [
          {
            "expr": "sum(rate(page_views_total[5m]))",
            "refId": "A",
            "legendFormat": "Page Views/sec"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 10,
              "gradientMode": "none",
              "axisPlacement": "auto",
              "drawStyle": "line",
              "pointSize": 5,
              "showPoints": "never"
            }
          }
        },
        "options": {
          "tooltip": {
            "mode": "single"
          },
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          }
        }
      },
      {
        "id": 12,
        "type": "timeseries",
        "title": "User Interactions",
        "gridPos": { "x": 12, "y": 26, "w": 12, "h": 6 },
        "targets": [
          {
            "expr": "sum(rate(user_interactions_total[5m])) by (interaction_type)",
            "refId": "A",
            "legendFormat": "{{interaction_type}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 10,
              "gradientMode": "none",
              "axisPlacement": "auto",
              "drawStyle": "line",
              "pointSize": 5,
              "showPoints": "never"
            }
          }
        },
        "options": {
          "tooltip": {
            "mode": "multi"
          },
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          }
        }
      },
      {
        "id": 13,
        "type": "heatmap",
        "title": "Session Duration Heatmap",
        "gridPos": { "x": 0, "y": 32, "w": 24, "h": 8 },
        "targets": [
          {
            "expr": "sum(increase(session_duration_bucket[1h])) by (le)",
            "refId": "A",
            "format": "heatmap",
            "legendFormat": "{{le}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          }
        },
        "options": {
          "calculate": false,
          "cellGap": 2,
          "color": {
            "scheme": "Spectral",
            "mode": "scheme"
          },
          "yAxis": {
            "unit": "s",
            "decimals": 0
          }
        }
      },
      {
        "type": "row",
        "title": "API Performance (User Perspective)",
        "gridPos": { "x": 0, "y": 40, "w": 24, "h": 1 },
        "collapsed": false
      },
      {
        "id": 14,
        "type": "timeseries",
        "title": "API Call Duration (Frontend)",
        "gridPos": { "x": 0, "y": 41, "w": 12, "h": 6 },
        "targets": [
          {
            "expr": "histogram_quantile(0.50, sum(rate(frontend_api_call_duration_bucket[5m])) by (le))",
            "refId": "A",
            "legendFormat": "p50"
          },
          {
            "expr": "histogram_quantile(0.95, sum(rate(frontend_api_call_duration_bucket[5m])) by (le))",
            "refId": "B",
            "legendFormat": "p95"
          },
          {
            "expr": "histogram_quantile(0.99, sum(rate(frontend_api_call_duration_bucket[5m])) by (le))",
            "refId": "C",
            "legendFormat": "p99"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ms",
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 10,
              "gradientMode": "none",
              "axisPlacement": "auto",
              "drawStyle": "line",
              "pointSize": 5,
              "showPoints": "never"
            }
          }
        },
        "options": {
          "tooltip": {
            "mode": "multi"
          },
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          }
        }
      },
      {
        "id": 15,
        "type": "table",
        "title": "Slowest API Endpoints (User-Facing)",
        "gridPos": { "x": 12, "y": 41, "w": 12, "h": 6 },
        "targets": [
          {
            "expr": "topk(10, histogram_quantile(0.95, sum(rate(frontend_api_call_duration_bucket[1h])) by (le, endpoint)))",
            "refId": "A",
            "format": "table",
            "instant": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ms"
          },
          "overrides": []
        },
        "options": {
          "showHeader": true,
          "sortBy": [
            {
              "displayName": "Value",
              "desc": true
            }
          ]
        },
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {
                "Time": true,
                "le": true
              },
              "renameByName": {
                "endpoint": "Endpoint",
                "Value": "p95 Duration (ms)"
              }
            }
          }
        ]
      }
    ]
  }
}
