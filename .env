# MarketSage Monitoring - Development Environment
NODE_ENV=development
ENVIRONMENT=development

# Service Ports (Development)
GRAFANA_PORT=3010
PROMETHEUS_PORT=9090
LOKI_PORT=3100
TEMPO_PORT=3200
ALERTMANAGER_PORT=9093

# Grafana (Development)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123
GRAFANA_SECRET_KEY=grafana-secret-key
GRAFANA_DOMAIN=localhost
GRAFANA_ROOT_URL=http://localhost:3010

# Prometheus (Development)
PROMETHEUS_RETENTION=30d
PROMETHEUS_SCRAPE_INTERVAL=15s
PROMETHEUS_EVALUATION_INTERVAL=15s
PROMETHEUS_FRONTEND_TARGET=localhost:3000
PROMETHEUS_BACKEND_TARGET=localhost:3006

# Loki (Development)
LOKI_RETENTION_PERIOD=168h
LOKI_MAX_QUERY_LENGTH=12000h

# Tempo (Development)
TEMPO_RETENTION=72h
TEMPO_MAX_BYTES_PER_TRACE=5000000

# Monitoring Targets (Development)
MONITOR_FRONTEND=true
MONITOR_BACKEND=true
MONITOR_DATABASE=true
MONITOR_REDIS=true

# Network Discovery (Development)
MARKETSAGE_NETWORK=marketsage_default
MARKETSAGE_FRONTEND_SERVICE=marketsage-frontend
MARKETSAGE_BACKEND_SERVICE=marketsage-backend
MARKETSAGE_DATABASE_SERVICE=marketsage-postgres
MARKETSAGE_REDIS_SERVICE=marketsage-redis

# Alerting (Development)
ALERT_RETENTION=120h
ALERT_EMAIL_ENABLED=true
ALERT_EMAIL_TO=alerts@marketsage.africa
ALERT_SLACK_ENABLED=false
ALERT_SLACK_WEBHOOK=

# Grafana Cloud (Development - Disabled)
GRAFANA_CLOUD_ENABLED=false
GRAFANA_CLOUD_API_KEY=your_api_key_here
GRAFANA_CLOUD_PROMETHEUS_URL=
GRAFANA_CLOUD_PROMETHEUS_USER=
GRAFANA_CLOUD_LOKI_URL=
GRAFANA_CLOUD_LOKI_USER=

# Security (Development)
MONITORING_NETWORK_POLICY=strict
MONITORING_IP_WHITELIST=127.0.0.1,::1
MONITORING_TLS_ENABLED=false
MONITORING_CERT_PATH=/etc/ssl/certs
MONITORING_KEY_PATH=/etc/ssl/private

# Data Sources (Development)
PROMETHEUS_URL=http://prometheus:9090
LOKI_URL=http://loki:3100
TEMPO_URL=http://tempo:3200

# Dashboard (Development)
DASHBOARD_REFRESH_INTERVAL=5s
DASHBOARD_TIME_RANGE=1h
DASHBOARD_AUTO_REFRESH=true
DASHBOARD_MARKETSAGE_OVERVIEW=true
DASHBOARD_API_PERFORMANCE=true
DASHBOARD_DATABASE_METRICS=true
DASHBOARD_BUSINESS_KPI=true
DASHBOARD_ERROR_TRACKING=true

# Performance Thresholds (Development)
RESPONSE_TIME_THRESHOLD=500ms
ERROR_RATE_THRESHOLD=1%
UPTIME_THRESHOLD=99.9%

# Features (Development)
ENABLE_DISTRIBUTED_TRACING=true
ENABLE_LOG_AGGREGATION=true
ENABLE_CUSTOM_METRICS=true
ENABLE_BUSINESS_METRICS=true

# Company Info
COMPANY_NAME=MarketSage
SUPPORT_EMAIL=support@marketsage.africa